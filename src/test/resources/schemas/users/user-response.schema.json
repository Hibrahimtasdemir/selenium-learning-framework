{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "username",
    "email"
  ],
  "properties": {
    "id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "minLength": 3
    }
  },
  "additionalProperties": true
}
