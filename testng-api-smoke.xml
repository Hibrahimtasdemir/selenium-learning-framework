<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Learning API Smoke Suite">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>
    <test name="API Smoke Tests">
        <groups>
            <run>
                <include name="api-smoke"/>
            </run>
        </groups>
        <packages>
            <package name="tests.api"/>
        </packages>
    </test>
</suite>
